# Copy this file to .env and adjust the values for your environment.
# .env is git-ignored; this file (.env.example) is committed as a reference template.

# --- Server ---
PORT=3000
HOST=localhost
NODE_ENV=development

# --- Environment exposure (per instance) ---
# Lets multiple servers SHARING the same database (e.g. production + a test server)
# to expose/execute only the environments each instance is meant to serve.
#   - If NONE of the three variables is set, every environment (dev, qa, prd) is exposed
#     (default behavior, single-instance deployments).
#   - If at least one is set, only the environments with value "true" are exposed.
# Effects on a non-exposed environment: its endpoints answer 403 "ENV_NOT_EXPOSED" (the
# response includes the list of exposed_environments), its MCP endpoint tools are not
# listed outside the "system" app, and its bots and interval tasks do NOT run here (so a
# shared database does not collide on a Telegram bot token or double-run scheduled tasks).
# The "system" app endpoints and MCP tools are always available on every instance.
# Example: production server (1) exposes only prd; test server (2) exposes only dev:
#EXPOSE_DEV_API=false
#EXPOSE_QA_API=false
#EXPOSE_PROD_API=true

# --- Auth ---
# Secret used to sign/verify JWTs and to hash user/api-client passwords
# (HMAC-SHA256). REQUIRED in ALL environments: there is no fallback or default
# key. If unset, the server boots in degraded mode: it logs the error, the root
# (/) shows which variables are missing and every /api/* responds 503.
# SECURITY: the placeholder below is PUBLIC and for local tests only. For any
# real deployment generate a random secret, e.g.:   openssl rand -hex 32
# MIGRATION: when upgrading from an older server, keep the SAME value the old
# server used (its password hashes, session tokens, api keys and OTPs depend on
# it). Never rotate JWT_KEY at the same time as the upgrade.
JWT_KEY=change-me-to-a-strong-random-secret

# Comma-separated list of JWT keys used by OLD deployments (e.g. the development
# fallback key, or the key of a server you are migrating from). During rolling
# migrations the login accepts hashes signed with any of these keys as a
# fallback, re-hashes the password with the current JWT_KEY on success and
# allows the migration without locking out existing users. Empty/absent => no
# legacy fallback.
#AUTH_LEGACY_KEYS=oy8632rcv"$/8,another-old-key

# Authentication rate limiting (in-memory, per IP and IP+username).
#AUTH_MAX_FAILURES=5
#AUTH_WINDOW_MS=600000
#AUTH_LOCKOUT_BASE_MS=5000
#AUTH_LOCKOUT_MAX_MS=86400000

# --- App functions ---
# Filesystem path where custom app function files live.
PATH_APP_FUNCTIONS=src/fn

# --- Uploads ---
# Max multipart upload size, in MB.
MAX_FILE_SIZE_UPLOAD=100

# --- Database (Sequelize) ---
# DATABASE_URL takes precedence over DATABASE_URI_API. If neither is set, the app
# falls back to a local sqlite file in the OS temp directory
# (/tmp/ofapi.sqlite) — it DOES NOT survive a reboot/container restart; use a real
# DATABASE_URL for anything persistent.
#DATABASE_URL=postgres://user:password@host:5432/dbname
#DATABASE_URI_API=postgres://user:password@host:5432/dbname
# Enable Heroku-style Postgres SSL options (rejectUnauthorized: false).
#USE_HEROKU_POSTGRESQL=true
# Prefix applied to all database table names.
#TABLE_NAME_PREFIX_API=
# FIRST BOOT: set BUILD_DB=true to create/alter the tables and seed the default
# apps, users, api clients, methods and interval tasks. Without it on an EMPTY
# database the server still starts, but every /api/* responds 500
# (SQLITE_ERROR: no such table) because the tables were never created.
# After the first successful boot you can comment it out again.
#BUILD_DB=true

# --- SQL handler tuning ---
# Idle-time threshold (ms) before validating a pooled SQL connection.
#OFAPI_SQL_POOL_VALIDATE_IDLE_MS=30000
# Force SQL pool connection validation on every use instead of only after idle timeout.
#OFAPI_SQL_POOL_FORCE_VALIDATE_ALWAYS=false
# Distinct SQL connection configs cached per process. Reaching the limit evicts the
# least recently requested connection, which can abort a query that is still running.
# Raise it when the log shows "[ConnectionPool] Pool at capacity".
#OFAPI_SQL_POOL_MAX_CONNECTIONS=50
# Enable live (non-cached) reads of App Vars in the SQL handler.
#OFAPI_APPVARS_LIVE_READ=false

# --- Clock sync (host/container clock drift correction) ---
# Disabled by default. Enable only if the host's system clock cannot be trusted
# (e.g. misconfigured RTC causing a fixed offset, common in some Docker setups). When
# enabled, the app periodically checks an external time source and, if the drift exceeds
# the threshold below, uses the corrected time everywhere a "now" timestamp is generated
# for something that leaves the process: JWTs (iat/exp/nbf), persisted log timestamps, and
# websocket event timestamps (which is what the Application dashboard charts are built from).
TIME_SYNC_ENABLED=false

# Comma-separated list of URLs to check for the real current time, tried in order until one
# responds. Defaults to a small built-in list (Cloudflare trace endpoint + generic HTTPS
# sites used only for their `Date` response header) if left unset.
#TIME_SYNC_URLS=https://www.cloudflare.com/cdn-cgi/trace,https://www.google.com,https://www.microsoft.com

# Minimum drift (ms) between the host clock and the external time source before a
# correction is applied; smaller differences are treated as normal network noise and
# ignored (the app behaves exactly as if TIME_SYNC_ENABLED were false). Defaults to 5
# minutes (300000) if unset.
#TIME_SYNC_THRESHOLD_MS=300000
